/*
 * pcie_bench — 官方 4_15 DMA 设计的用户态测速（无 libc、32 位 ARM、原始系统调用）。
 *
 * 为什么是 32 位 ARM：RK 板没有 gcc，PC 上唯一能用的编译器是 ST 的 starm-clang（只有 ARM 目标）；
 * 内核 CONFIG_COMPAT=y，Cortex-A55 可以跑 AArch32 静态程序。
 *
 * 做法：mmap /dev/mem
 *   - BAR1（DMA 寄存器，默认 0xf0204000，4KB）
 *   - ramoops:pmsg 保留区（0x1b0000..0x1fffff，不被内核当 RAM 用）作为 DMA 缓冲区
 * 寄存器（来自 linux/driver/pango_pci_driver.h）：
 *   "write"(主机→FPGA RAM，FPGA 发 MRd): 0x100/0x104 主机地址低/高, 0x110 RAM 偏移, 0x120 长度(DW-1), 0x140 地址类型(触发), 0x130 done==1
 *   "read" (FPGA RAM→主机，FPGA 发 MWr): 0x200/0x204/0x210/0x220/0x240 触发, 0x230 done!=0
 *
 * 用前提：echo 1 > /sys/bus/pci/devices/0002:21:00.0/enable，且 EP 的 COMMAND 里 Bus Master=1。
 *
 * 用法: pcie_bench [bar1_phys_hex] [iters]
 */
typedef unsigned int u32;
typedef unsigned long long u64;

/* ---------- raw syscalls (ARM EABI) ---------- */
static inline long sc(long n, long a, long b, long c, long d, long e, long f)
{
    register long r0 __asm__("r0") = a;
    register long r1 __asm__("r1") = b;
    register long r2 __asm__("r2") = c;
    register long r3 __asm__("r3") = d;
    register long r4 __asm__("r4") = e;
    register long r5 __asm__("r5") = f;
    register long r7 __asm__("r7") = n;
    __asm__ volatile("svc 0" : "+r"(r0) : "r"(r1), "r"(r2), "r"(r3), "r"(r4), "r"(r5), "r"(r7) : "memory");
    return r0;
}
#define SYS_exit_group 248
#define SYS_open 5
#define SYS_write 4
#define SYS_mmap2 192
#define SYS_clock_gettime 263
#define SYS_sched_setaffinity 241

struct ts32 { long sec; long nsec; };

static u64 now_ns(void)
{
    struct ts32 t;
    sc(SYS_clock_gettime, 1 /*CLOCK_MONOTONIC*/, (long)&t, 0, 0, 0, 0);
    return (u64)(u32)t.sec * 1000000000ULL + (u32)t.nsec;
}

/* ---------- tiny libc-ish helpers ---------- */
void *memset(void *p, int c, unsigned n) { unsigned char *q = p; while (n--) *q++ = (unsigned char)c; return p; }
void *memcpy(void *d, const void *s, unsigned n) { unsigned char *a = d; const unsigned char *b = s; while (n--) *a++ = *b++; return d; }

static u64 udiv64(u64 n, u64 d)
{
    u64 q = 0, r = 0;
    int i;
    if (!d) return 0;
    for (i = 63; i >= 0; i--) {
        r = (r << 1) | ((n >> i) & 1);
        if (r >= d) { r -= d; q |= 1ULL << i; }
    }
    return q;
}

static void out(const char *s) { unsigned n = 0; while (s[n]) n++; sc(SYS_write, 1, (long)s, n, 0, 0, 0); }
static void outu(u64 v)
{
    char b[24]; int i = 23; b[i] = 0;
    if (!v) b[--i] = '0';
    while (v) { u64 q = udiv64(v, 10); b[--i] = (char)('0' + (unsigned)(v - q * 10)); v = q; }
    out(b + i);
}
/* v10 = value*10 → "x.y" */
static void outf1(u64 v10) { u64 ip = udiv64(v10, 10); outu(ip); out("."); outu(v10 - ip * 10); }
static void outpad(u64 v, int w) { char b[24]; int n = 0; u64 t = v; do { n++; t = udiv64(t, 10); } while (t); while (w-- > n) out(" "); outu(v); }
static void outhex(u32 v) { const char *h = "0123456789abcdef"; char b[11]; int i; b[0] = '0'; b[1] = 'x'; for (i = 0; i < 8; i++) b[2 + i] = h[(v >> (28 - 4 * i)) & 15]; b[10] = 0; out(b); }
static u32 parse_hex(const char *s) { u32 v = 0; if (s[0] == '0' && (s[1] == 'x' || s[1] == 'X')) s += 2; while (*s) { char c = *s++; v <<= 4; if (c >= '0' && c <= '9') v |= (u32)(c - '0'); else if (c >= 'a' && c <= 'f') v |= (u32)(c - 'a' + 10); else if (c >= 'A' && c <= 'F') v |= (u32)(c - 'A' + 10); } return v; }
static u32 parse_dec(const char *s) { u32 v = 0; while (*s >= '0' && *s <= '9') v = v * 10 + (u32)(*s++ - '0'); return v; }

/* ---------- device ---------- */
static volatile u32 *regs;   /* BAR1 */
static volatile u32 *bufA;   /* host memory, phys PHYS_A */
static volatile u32 *bufB;   /* host memory, phys PHYS_B */
/* 20261018 mrd: 长读 DMA 源缓冲，覆盖整块保留内存 0x1b0000-0x1fffff（320KB） */
static volatile u32 *bufL;
#define PHYS_L 0x001b0000u
#define BUF_L_SZ 0x50000u
#define PHYS_A 0x001b0000u
#define PHYS_B 0x001b8000u   /* A,B each 32KB, inside ramoops:pmsg (0x1b0000-0x1fffff) */
#define BUF_SZ 0x8000u
#define BUF_B_SZ 0x48000u   /* 20261018 ext: bufB 覆盖到 0x200000，供扩展长度 MWr 测试 */

static inline void wr(u32 off, u32 v) { regs[off >> 2] = v; }
static inline u32 rd(u32 off) { return regs[off >> 2]; }

#define POLL_LIMIT 20000000u
static u32 st_stale, st_noclear;   /* 统计: 触发后第一次读 done 仍为"完成"的次数 / 64 次读都没看到 busy 的次数 */

/* 触发后: 先等 done 被引擎清零(busy)，再等 done 置位；读到 0xFFFFFFFF = EP 已掉线/内存空间被关 */
static int wait_done(u32 off, int want_one)
{
    u32 n = POLL_LIMIT, v;
    /* 20261018: done 寄存器读即清零（rt0206_data_mux.v:52-62），上一次的 done 已被上次 wait_done 读走。
       FAST_PATH 下小包在第一次读之前就已完成，原来"先等 busy"的做法会把这次的 done 当旧值读掉而超时，
       所以直接轮询到置位为止（st_stale/st_noclear 不再统计，恒为 0）。 */
    for (;;) {
        v = rd(off);
        if (v == 0xFFFFFFFFu) return -2;
        if (want_one ? v == 1 : v != 0) return 0;
        if (!--n) return -1;
    }
}

/* host→FPGA RAM ("write" regs) : FPGA issues MRd to host memory */
static int op_w(u32 phys, u32 len)
{
    wr(0x100, phys); wr(0x104, 0); wr(0x110, 0); wr(0x120, (len >> 2) - 1); wr(0x140, 0);
    return wait_done(0x130, 1);
}
/* FPGA RAM→host ("read" regs) : FPGA issues MWr to host memory */
static int op_r(u32 phys, u32 len)
{
    wr(0x200, phys); wr(0x204, 0); wr(0x210, 0); wr(0x220, (len >> 2) - 1); wr(0x240, 0);
    return wait_done(0x230, 0);
}
/* 20261018 ext: 与 op_w 相同，0x110 写 FPGA RAM 起始偏移（单位 16 位字） */
static int op_w_off(u32 phys, u32 len, u32 ramoff16)
{
    wr(0x100, phys); wr(0x104, 0); wr(0x110, ramoff16); wr(0x120, (len >> 2) - 1); wr(0x140, 0);
    return wait_done(0x130, 1);
}
/* 20261018 ext: 扩展长度 MWr，0x250 指定长度(DW)，非 0 时取代 0x220 的 4KB 上限 */
static int op_r_ext(u32 phys, u32 bytes)
{
    wr(0x200, phys); wr(0x204, 0); wr(0x210, 0); wr(0x220, 1023); wr(0x250, bytes >> 2); wr(0x240, 0);
    return wait_done(0x230, 0);
}
/* 20261018 mrd: 长读 DMA（FPGA 发 MRd 读主机内存），bytes 为字节数，limit 为最大未完成 MRd 数 */
static int op_mrd_long(u32 phys, u32 bytes, u32 limit, u32 seed)
{
    wr(0x158, seed); wr(0x154, limit); wr(0x150, bytes >> 2);
    wr(0x100, phys); wr(0x104, 0); wr(0x110, 0); wr(0x120, 1023); wr(0x140, 0);
    return wait_done(0x130, 1);
}

/* 20261018 ext: 扩展长度 MWr 测试：8KB 参考数据，逐档长度回读校验 */
static int ext_test(u32 iters)
{
    static const u32 sk[] = {8192, 16384, 32768, 65536, 131072, 262144};
    u32 seed = (u32)now_ns(), i, bad, k, S, anybad = 0;
    int ns = (int)(sizeof(sk) / sizeof(sk[0])), si;
    u64 t0, dt;
    if (!iters) iters = 1;
    for (i = 0; i < 1024; i++) bufA[i] = seed ^ (i * 0x9E3779B1u);
    if (op_w_off(PHYS_A, 4096, 0)) { out("!! ext: load timeout\n"); return 4; }
    for (i = 0; i < 1024; i++) bufA[i] = seed ^ ((i + 1024) * 0x9E3779B1u);
    if (op_w_off(PHYS_A, 4096, 2048)) { out("!! ext: load timeout\n"); return 4; }

    for (si = 0; si < ns; si++) {
        S = sk[si];
        for (k = 0; k < (S >> 2); k++) bufB[k] = 0;
        t0 = now_ns();
        for (i = 0; i < iters; i++) {
            if (op_r_ext(PHYS_B, S)) {
                out("!! ext timeout S="); outu(S); out(" iter="); outu(i); out("\n");
                wr(0x250, 0);
                return 6;
            }
        }
        dt = now_ns() - t0;
        bad = 0;
        for (k = 0; k < (S >> 2); k++) if (bufB[k] != (seed ^ ((k % 2048) * 0x9E3779B1u))) bad++;
        if (bad) anybad = 1;
        out("ext S="); outu(S); out(" ns/op="); outu(udiv64(dt, iters));
        out(" MB/s="); outu(udiv64((u64)S * iters * 1000ULL, dt));
        out(" verify="); if (bad) { out("bad="); outu(bad); } else out("OK"); out("\n");
    }
    wr(0x250, 0);
    return anybad ? 5 : 0;
}

/* ---------- 20261018 mrd: 长读 DMA 状态/矩阵/图像/浸泡 ---------- */
struct mrd_st {
    u32 err, beats, sum, fei, fed, fex, issued, status, cycles, freed, magic, tags;
};

static void mrd_get(struct mrd_st *s)
{
    s->err = rd(0x160); s->beats = rd(0x164); s->sum = rd(0x168);
    s->fei = rd(0x16C); s->fed = rd(0x170); s->fex = rd(0x174);
    s->issued = rd(0x178); s->status = rd(0x17C); s->cycles = rd(0x180);
    s->freed = rd(0x184); s->magic = rd(0x188); s->tags = rd(0x18C);
}

static void mrd_dump(const struct mrd_st *s)
{
    out("  err="); outhex(s->err); out(" beats="); outhex(s->beats);
    out(" sum="); outhex(s->sum); out(" first_idx="); outhex(s->fei); out("\n");
    out("  first_data="); outhex(s->fed); out(" first_exp="); outhex(s->fex);
    out(" issued="); outhex(s->issued); out(" status="); outhex(s->status); out("\n");
    out("  cycles="); outhex(s->cycles); out(" freed="); outhex(s->freed);
    out(" magic="); outhex(s->magic); out(" tags="); outhex(s->tags); out("\n");
}

static u32 xs32(u32 x) { x ^= x << 13; x ^= x >> 17; x ^= x << 5; return x; }
static inline u32 mrd_pat(u32 seed, u32 k) { return seed ^ k ^ (k << 16); }

/* 填测试图并返回主机算出的 32 位和 */
static u32 fill_pat(u32 seed, u32 ndw)
{
    u32 k, s = 0;
    for (k = 0; k < ndw; k++) { u32 v = mrd_pat(seed, k); bufL[k] = v; s += v; }
    return s;
}

static int mrd_check(const struct mrd_st *s, u32 bytes, u32 exp_sum, u32 limit)
{
    if (s->err) return 1;
    if (s->beats != (bytes >> 4)) return 1;
    if (s->sum != exp_sum) return 1;
    if (s->fei != 0xFFFFFFFFu) return 1;
    if (s->freed != s->issued) return 1;
    if ((s->status & 0x3Fu) != 0) return 1;
    if (((s->status >> 8) & 0x3Fu) > limit) return 1;
    return 0;
}

static void mrd_fail(const struct mrd_st *s, u32 bytes, u32 limit, u32 iter, u32 seed, u32 exp_sum)
{
    out("!! fail len="); outu(bytes); out(" limit="); outu(limit);
    out(" iter="); outu(iter); out(" seed="); outhex(seed);
    out(" exp_sum="); outhex(exp_sum); out(" exp_beats="); outhex(bytes >> 4); out("\n");
    mrd_dump(s);
}

/* 20261018 mrd: 旧模式 4096B 回环校验（与 cmain 第 2 步相同） */
static int mrd_regress(void)
{
    u32 i, bad = 0, seed = (u32)now_ns();
    for (i = 0; i < 1024; i++) { bufA[i] = seed ^ (i * 0x9E3779B1u); bufB[i] = 0; }
    if (op_w(PHYS_A, 4096)) { out("loopback 4096B verify  : FAIL (write timeout)\n"); return 1; }
    if (op_r(PHYS_B, 4096)) { out("loopback 4096B verify  : FAIL (read timeout)\n"); return 1; }
    for (i = 0; i < 1024; i++) if (bufB[i] != (seed ^ (i * 0x9E3779B1u))) bad++;
    out("loopback 4096B verify  : "); out(bad ? "FAIL, bad dwords=" : "OK"); if (bad) outu(bad); out("\n");
    return bad ? 1 : 0;
}

static int mrd_matrix(u32 iters)
{
    static const u32 lens[] = {4096, 16384, 65536, 131072, 262144, 327680};
    static const u32 lims[] = {1, 2, 4, 8, 12, 16, 24, 32};
    int nl = (int)(sizeof(lens) / sizeof(lens[0])), nlim = (int)(sizeof(lims) / sizeof(lims[0]));
    int li, mi, anyfail = 0;
    u32 rng = (u32)now_ns() | 1, dumps = 0;

    for (li = 0; li < nl; li++) {
        for (mi = 0; mi < nlim; mi++) {
            u32 bytes = lens[li], limit = lims[mi];
            u32 i, fails = 0, mx = 0, is = 0, best_cyc = 0xFFFFFFFFu;
            u64 sum_cyc = 0, host_ns = 0;

            for (i = 0; i < iters; i++) {
                struct mrd_st st;
                u32 seed, exp_sum, bad;
                int rc;
                u64 t0;

                rng = xs32(rng); seed = rng;
                exp_sum = fill_pat(seed, bytes >> 2);
                t0 = now_ns();
                rc = op_mrd_long(PHYS_L, bytes, limit, seed);
                host_ns += now_ns() - t0;

                if (rc == -1) {
                    out("!! MRD2 timeout len="); outu(bytes); out(" limit="); outu(limit);
                    out(" iter="); outu(i); out("\n");
                    mrd_get(&st); mrd_dump(&st);
                    wr(0x15C, 1); wr(0x150, 0);
                    return 6;
                }
                if (rc == -2) { out("!! EP lost\n"); return 3; }

                mrd_get(&st);
                sum_cyc += st.cycles;
                if (st.cycles < best_cyc) best_cyc = st.cycles;
                if (mrd_check(&st, bytes, exp_sum, limit)) {
                    fails++; anyfail = 1;
                    if (dumps < 5) { dumps++; mrd_fail(&st, bytes, limit, i, seed, exp_sum); }
                } else {
                    u32 mo = (st.status >> 8) & 0x3Fu;
                    if (mo > mx) mx = mo;
                    is = st.issued;
                }

                /* 长度为 8192 倍数时，校验 FPGA 8KB 环形 RAM 尾部 */
                if ((bytes & 8191u) == 0) {
                    u32 t;
                    bad = 0;
                    rc = op_r_ext(PHYS_L, 8192);
                    wr(0x250, 0);
                    if (rc == -1) {
                        out("!! MRD2 tail-read timeout len="); outu(bytes); out(" iter="); outu(i); out("\n");
                        mrd_get(&st); mrd_dump(&st);
                        wr(0x15C, 1); wr(0x150, 0);
                        return 6;
                    }
                    if (rc == -2) { out("!! EP lost\n"); return 3; }
                    for (t = 0; t < 2048; t++) {
                        u32 k = ((bytes - 8192) >> 2) + t;
                        if (bufL[t] != mrd_pat(seed, k)) bad++;
                    }
                    if (bad) {
                        fails++; anyfail = 1;
                        out("!! tail fail len="); outu(bytes); out(" limit="); outu(limit);
                        out(" iter="); outu(i); out(" bad="); outu(bad); out("\n");
                        if (dumps < 5) { dumps++; mrd_dump(&st); }
                    }
                }
            }

            out("L "); outpad(bytes, 7); out(" "); outpad(limit, 3);
            out(" max_out="); outu(mx); out(" issued="); outu(is);
            out(" best="); outf1(udiv64((u64)bytes * 1250ULL, best_cyc));
            out(" avg="); outf1(udiv64((u64)bytes * iters * 1250ULL, sum_cyc));
            out(" MB/s host="); outu(udiv64(host_ns, iters));
            out(" ns/op fail="); outu(fails); out("\n");
        }
    }
    return anyfail ? 5 : 0;
}

/* 960x540 RGB565：4 条带，每条 135 行 x 1920 字节 = 259200 字节 */
#define IMG_STRIP_BYTES 259200u
static u32 img_rt[960], img_gt[270], img_bt[960];

static void img_tables(void)
{
    static const u32 bc[8] = {0xFFFF, 0xFFE0, 0x07FF, 0x07E0, 0xF81F, 0xF800, 0x001F, 0x0000};
    u32 i;
    for (i = 0; i < 960; i++) {
        img_rt[i] = (u32)udiv64((u64)i * 31ULL, 959);
        img_bt[i] = bc[(u32)udiv64(i, 120)];
    }
    for (i = 0; i < 270; i++) img_gt[i] = (u32)udiv64((u64)i * 63ULL, 269);
}

static u32 img_fill(u32 strip, u32 frame)
{
    volatile u32 *p = bufL;
    u32 row, x, y = strip * 135, s = 0, off = (frame * 8) & 31;
    for (row = 0; row < 135; row++, y++) {
        if (y < 270) {
            for (x = 0; x < 960; x += 2) {
                u32 v = img_bt[x] | (img_bt[x + 1] << 16);
                *p++ = v; s += v;
            }
        } else {
            u32 g = img_gt[y - 270];
            for (x = 0; x < 960; x += 2) {
                u32 lo = (img_rt[x] << 11) | (g << 5) | ((x + off) & 31);
                u32 hi = (img_rt[x + 1] << 11) | (g << 5) | ((x + 1 + off) & 31);
                u32 v = lo | (hi << 16);
                *p++ = v; s += v;
            }
        }
    }
    return s;
}

static int mrd_image(u32 iters)
{
    u32 f, fails = 0, first = 0;
    u64 acc_cyc = 0, acc_bytes = 0, host_ns = 0;

    img_tables();
    for (f = 0; f < iters; f++) {
        u64 t0 = now_ns();
        u32 st_i, frame_ok = 1;
        for (st_i = 0; st_i < 4; st_i++) {
            struct mrd_st st;
            u32 exp_sum;
            int rc;
            exp_sum = img_fill(st_i, f);
            rc = op_mrd_long(PHYS_L, IMG_STRIP_BYTES, 16, f);
            if (rc == -1) {
                out("!! MRD2 image timeout frame="); outu(f); out(" strip="); outu(st_i); out("\n");
                mrd_get(&st); mrd_dump(&st);
                wr(0x15C, 1); wr(0x150, 0);
                return 6;
            }
            if (rc == -2) { out("!! EP lost\n"); return 3; }
            mrd_get(&st);
            acc_cyc += st.cycles;
            acc_bytes += IMG_STRIP_BYTES;
            if (st.beats != (IMG_STRIP_BYTES >> 4) || st.sum != exp_sum) {
                frame_ok = 0;
                if (first < 5) {
                    first++;
                    out("!! image fail frame="); outu(f); out(" strip="); outu(st_i);
                    out(" exp_sum="); outhex(exp_sum);
                    out(" exp_beats="); outhex(IMG_STRIP_BYTES >> 4); out("\n");
                    mrd_dump(&st);
                }
            }
        }
        if (!frame_ok) fails++;
        host_ns += now_ns() - t0;
    }
    out("mrd image frames="); outu(iters); out(" fail="); outu(fails);
    out(" fpga="); outf1(udiv64(acc_cyc * 80ULL, (u64)iters * 1000ULL)); out(" us/frame");
    out(" "); outf1(udiv64(acc_bytes * 1250ULL, acc_cyc)); out(" MB/s");
    out(" host="); outf1(udiv64(host_ns * 10ULL, (u64)iters * 1000ULL)); out(" us/frame\n");
    return fails ? 5 : 0;
}

static void soak_line(u32 round, u32 fails, u64 bytes, u64 cyc)
{
    out("S round="); outu(round); out(" fail="); outu(fails);
    out(" bytes="); outu(bytes);
    out(" avg="); outf1(udiv64(bytes * 1250ULL, cyc)); out(" MB/s\n");
}

static int mrd_soak(u32 iters)
{
    u32 rng = (u32)now_ns() | 1;
    u32 round, fails = 0, printed = 0, next_lb = 100, next_pr = 1000, last = iters;
    u64 cum_bytes = 0, cum_cyc = 0;

    if (!iters) iters = 1;
    last = iters;
    for (round = 1; round <= iters; round++) {
        struct mrd_st st;
        u32 seed, bytes, limit, exp_sum, m;
        int rc;

        rng = xs32(rng); seed = rng;
        rng = xs32(rng);
        m = rng - (u32)udiv64(rng, 1280) * 1280;
        bytes = (m + 1) * 256;
        rng = xs32(rng); limit = (rng & 15u) + 1;
        exp_sum = fill_pat(seed, bytes >> 2);

        rc = op_mrd_long(PHYS_L, bytes, limit, seed);
        if (rc == -1) {
            out("!! MRD2 soak timeout round="); outu(round); out("\n");
            mrd_get(&st); mrd_dump(&st);
            wr(0x15C, 1); wr(0x150, 0);
            return 6;
        }
        if (rc == -2) { out("!! EP lost\n"); return 3; }

        mrd_get(&st);
        cum_bytes += bytes; cum_cyc += st.cycles;
        if (mrd_check(&st, bytes, exp_sum, limit)) {
            fails++;
            if (fails == 1) mrd_fail(&st, bytes, limit, round, seed, exp_sum);
            if (fails > 10) { out("!! too many failures, stop\n"); last = round; break; }
        }

        if (round == next_lb) {
            wr(0x150, 0);
            if (mrd_regress()) {
                fails++;
                out("!! loopback failed at round="); outu(round); out("\n");
                if (fails > 10) { out("!! too many failures, stop\n"); last = round; break; }
            }
            next_lb += 100;
        }
        if (round == next_pr) { soak_line(round, fails, cum_bytes, cum_cyc); printed = round; next_pr += 1000; }
    }
    wr(0x150, 0); wr(0x154, 0);
    if (printed != last) soak_line(last, fails, cum_bytes, cum_cyc);
    return fails ? 5 : 0;
}

static int mrd_long_test(u32 iters)
{
    int rc, anyfail = 0;

    if (!iters) iters = 20;
    out("\n=== MRD2 long-read ===\n");
    if (rd(0x188) != 0x4D524432u) {
        out("!! bitstream lacks MRD2\n");
        out("  0x180="); outhex(rd(0x180));
        out(" 0x184="); outhex(rd(0x184));
        out(" 0x188="); outhex(rd(0x188));
        out(" 0x18C="); outhex(rd(0x18C)); out("\n");
        return 7;
    }
    rc = mrd_matrix(iters);
    if (rc == 6 || rc == 3) return rc;
    if (rc) anyfail = 1;
    rc = mrd_image(iters);
    if (rc == 6 || rc == 3) return rc;
    if (rc) anyfail = 1;
    wr(0x150, 0); wr(0x154, 0);
    if (mrd_regress()) anyfail = 1;
    if (anyfail) { out("MRD2 long-read: FAIL\n"); return 5; }
    out("MRD2 long-read: ALL PASS\n");
    return 0;
}

static u64 bench(int dir, u32 len, u32 iters)
{
    u32 i;
    u64 t0 = now_ns();
    for (i = 0; i < iters; i++) {
        int rc = dir == 0 ? op_w(PHYS_A, len) : op_r(PHYS_B, len);
        if (rc) {
            out(rc == -2 ? "!! reg read 0xFFFFFFFF: EP lost / memory space off (dir " : "!! timeout waiting done (dir ");
            outu((u64)dir); out(") len="); outu(len); out(" iter="); outu(i); out("\n");
            sc(SYS_exit_group, 3, 0, 0, 0, 0, 0);
        }
    }
    return now_ns() - t0;
}

static void *map(int fd, u32 phys, u32 len)
{
    long r = sc(SYS_mmap2, 0, len, 3 /*RW*/, 1 /*SHARED*/, fd, phys >> 12);
    if (r < 0 && r > -4096) { out("!! mmap failed phys="); outhex(phys); out(" err="); outu((u64)(-r)); out("\n"); sc(SYS_exit_group, 2, 0, 0, 0, 0, 0); }
    return (void *)r;
}

int cmain(u32 *sp)
{
    u32 argc = sp[0];
    char **argv = (char **)(sp + 1);
    u32 bar1 = 0xf0204000u, iters = 20000;
    int iters_set = 0;
    static const u32 lens[] = {64, 128, 256, 512, 1024, 2048, 4096};
    int nl = (int)(sizeof(lens) / sizeof(lens[0])), k, dir, rep;
    long fd;
    u32 mask = 1u << 3;   /* pin to CPU3 */
    u64 best[2][8];
    u32 dirs = 3;
    int ext = 0;   /* 20261018 ext: argv[3] 以 'x' 开头时只跑扩展长度 MWr 测试 */

    if (argc > 1) bar1 = parse_hex(argv[1]);
    if (argc > 2) { iters = parse_dec(argv[2]); iters_set = 1; }
    if (argc > 3) { dirs = 0; if (argv[3][0] == 'x') ext = 1; else { const char *d = argv[3]; while (*d) { if (*d == 'w') dirs |= 1; if (*d == 'r') dirs |= 2; d++; } } }
    sc(SYS_sched_setaffinity, 0, 4, (long)&mask, 0, 0, 0);

    fd = sc(SYS_open, (long)"/dev/mem", 0x101002 /*O_RDWR|O_SYNC*/, 0, 0, 0, 0);
    if (fd < 0) { out("!! open /dev/mem failed\n"); return 1; }
    regs = (volatile u32 *)map((int)fd, bar1, 0x1000);
    bufA = (volatile u32 *)map((int)fd, PHYS_A, BUF_SZ);
    bufB = (volatile u32 *)map((int)fd, PHYS_B, BUF_B_SZ);
    bufL = (volatile u32 *)map((int)fd, PHYS_L, BUF_L_SZ);   /* 20261018 mrd */

    out("BAR1="); outhex(bar1); out(" bufA="); outhex(PHYS_A); out(" bufB="); outhex(PHYS_B); out(" iters="); outu(iters); out("\n");

    if (ext) return ext_test(iters);   /* 20261018 ext: 只跑扩展长度 MWr 测试 */
    if (argc > 3 && argv[3][0] == 'L') return mrd_long_test(iters_set ? iters : 20);   /* 20261018 mrd */
    if (argc > 3 && argv[3][0] == 'S') return mrd_soak(iters);                           /* 20261018 mrd */

    /* 1) MMIO 单次访问开销 */
    {
        u32 n = 200000, i; u64 t0, dt; volatile u32 sink = 0;
        t0 = now_ns(); for (i = 0; i < n; i++) sink += rd(0x130); dt = now_ns() - t0;
        out("MMIO read  (non-posted) : "); outf1(udiv64(dt * 10, n)); out(" ns each\n");
        t0 = now_ns(); for (i = 0; i < n; i++) wr(0x110, 0); dt = now_ns() - t0;
        out("MMIO write (posted)     : "); outf1(udiv64(dt * 10, n)); out(" ns each\n");
        (void)sink;
    }

    /* 2) 回环校验 4096B：主机 A → FPGA RAM → 主机 B */
    {
        u32 i, bad = 0, seed = (u32)now_ns();   /* 20261018: 每轮不同的数据，防止 FPGA RAM 里的旧数据让校验"碰巧"通过 */
        for (i = 0; i < 1024; i++) { bufA[i] = seed ^ (i * 0x9E3779B1u); bufB[i] = 0; }
        if (op_w(PHYS_A, 4096)) { out("!! verify: write op timeout\n"); return 4; }
        if (op_r(PHYS_B, 4096)) { out("!! verify: read op timeout\n"); return 4; }
        for (i = 0; i < 1024; i++) if (bufB[i] != (seed ^ (i * 0x9E3779B1u))) bad++;
        out("loopback 4096B verify  : "); out(bad ? "FAIL, bad dwords=" : "OK"); if (bad) outu(bad); out("\n");
        if (bad) return 5;
    }

    /* 3) 长度扫描，每点取 5 次中最快 */
    out("\n len(B) | host->FPGA(MRd by FPGA)  ns/op   MB/s | FPGA->host(MWr by FPGA)  ns/op   MB/s\n");
    for (k = 0; k < nl; k++) {
        for (dir = 0; dir < 2; dir++) {
            u64 b = ~0ULL;
            if (!(dirs & (1u << dir))) { best[dir][k] = 0; continue; }
            for (rep = 0; rep < 5; rep++) { u64 t = bench(dir, lens[k], iters); if (t < b) b = t; }
            best[dir][k] = b;
        }
        outpad(lens[k], 7); out(" | ");
        for (dir = 0; dir < 2; dir++) {
            u64 b = best[dir][k];
            out("                       ");
            if (!b) { out("     -       -"); } else { outpad(udiv64(b, iters), 6); out("  "); outpad(udiv64((u64)lens[k] * iters * 1000ULL, b), 6); }
            out(dir == 0 ? " | " : "\n");
        }
    }

    /* 4) 线性拟合：t(len) = t0 + len/BW，用 1024B 与 4096B 两点 */
    {
        int i1 = 4, i2 = 6;
        for (dir = 0; dir < 2; dir++) {
            u64 ta = udiv64(best[dir][i1], iters), tb = udiv64(best[dir][i2], iters);
            out(dir == 0 ? "\nfit host->FPGA : " : "fit FPGA->host : ");
            if (tb > ta) {
                u64 bw10 = udiv64((u64)(lens[i2] - lens[i1]) * 10000ULL, tb - ta);   /* MB/s *10 */
                u64 over = ta - udiv64((u64)lens[i1] * 10000ULL, bw10) * 1;          /* ns 近似: t(1024)-1024/BW */
                out("slope-BW ~ "); outf1(bw10); out(" MB/s, per-op overhead ~ "); outu(over); out(" ns\n");
            } else out("not monotonic\n");
        }
    }
    out("\nstale-done first-read: "); outu(st_stale); out("  busy-never-seen: "); outu(st_noclear); out("\n");
    return 0;
}

__asm__(".text\n.global _start\n_start:\n mov r0, sp\n bl cmain\n mov r7, #248\n svc 0\n");

###==== BEGIN disp clk groups (20261018 disp)
create_generated_clock -name {pix_clk} -source [get_ports {free_clk}] [get_pins {u_rt_disp_top/u_pll_pix/u_gpll/CLKOUT0}] -master_clock [get_clocks {free_clk}] -multiply_by 11 -divide_by 2
create_generated_clock -name {cfg_clk} -source [get_ports {free_clk}] [get_pins {u_rt_disp_top/u_pll_cfg/u_gpll/CLKOUT0}] -master_clock [get_clocks {free_clk}] -multiply_by 10 -divide_by 27
set_clock_groups -name group_pix_clk -asynchronous -group [get_clocks {pix_clk}]
set_clock_groups -name group_cfg_clk -asynchronous -group [get_clocks {cfg_clk}]


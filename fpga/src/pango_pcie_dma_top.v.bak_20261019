module pango_pcie_dma_top 
(
    //clk and rst
    input                       ref_clk_n       ,      //100 Mhz
    input                       ref_clk_p       ,      //100 Mhz
    input                       free_clk        ,      // 20261017 log: 27MHz onboard osc (D18)
    input           [4:0]       key             ,      // 20261018 disp: KEY0..KEY4
    input                       perst_n         ,
    // 20261018 ddr: DDR3 interface
    input                       clk_p           ,      // 20261018 ddr:
    input                       clk_n           ,      // 20261018 ddr:
    output  wire                mem_rst_n       ,      // 20261018 ddr:
    output  wire                mem_ck          ,      // 20261018 ddr:
    output  wire                mem_ck_n        ,      // 20261018 ddr:
    output  wire                mem_cke         ,      // 20261018 ddr:
    output  wire                mem_cs_n        ,      // 20261018 ddr:
    output  wire                mem_ras_n       ,      // 20261018 ddr:
    output  wire                mem_cas_n       ,      // 20261018 ddr:
    output  wire                mem_we_n        ,      // 20261018 ddr:
    output  wire                mem_odt         ,      // 20261018 ddr:
    output  wire    [14:0]      mem_a           ,      // 20261018 ddr:
    output  wire    [2:0]       mem_ba          ,      // 20261018 ddr:
    inout           [3:0]       mem_dqs         ,      // 20261018 ddr:
    inout           [3:0]       mem_dqs_n       ,      // 20261018 ddr:
    inout           [31:0]      mem_dq          ,      // 20261018 ddr:
    output  wire    [3:0]       mem_dm          ,      // 20261018 ddr:
    //UART interface
    output  wire                txd             ,
    input                       rxd             ,
    //diff signals
    input           [3:0]       rxn             ,
    input           [3:0]       rxp             ,
    output  wire    [3:0]       txn             ,
    output  wire    [3:0]       txp             ,

    //LED signals
    output  wire    [7:0]       led             ,   // 20261018 disp: LED0..LED7

    //HDMI output (20261018 disp)
    output  wire                pix_clk         ,
    output  wire                vs_out          ,
    output  wire                hs_out          ,
    output  wire                de_out          ,
    output  wire    [7:0]       r_out           ,
    output  wire    [7:0]       g_out           ,
    output  wire    [7:0]       b_out           ,
    output  wire                hd_scl          ,
    inout                       hd_sda          ,
    output  wire                rstn_out
);


localparam      ADDR_WIDTH    = 'd32    ;  
localparam      RD_DATA_DELAY = 'd1     ;   


//RESET DEBOUNCE and SYNC
wire            sync_button_rst_n       ;
wire            s_pclk_rstn             ;

//********************** internal signal
//clk and rst
wire            pclk_div2               /* synthesis PAP_MARK_DEBUG=”true”*/;
wire            pclk                    ;
wire            ref_clk                 ;
wire            core_rst_n              ;
//AXIS master interface
wire            axis_master_tvalid      /* synthesis PAP_MARK_DEBUG=”true”*/;
wire            axis_master_tready      /* synthesis PAP_MARK_DEBUG=”true”*/;
wire    [127:0] axis_master_tdata       /* synthesis PAP_MARK_DEBUG=”true”*/;
wire    [3:0]   axis_master_tkeep       /* synthesis PAP_MARK_DEBUG=”true”*/;
wire            axis_master_tlast       /* synthesis PAP_MARK_DEBUG=”true”*/;
wire    [7:0]   axis_master_tuser       /* synthesis PAP_MARK_DEBUG=”true”*/;

//axis slave 0 interface
wire            axis_slave0_tready      /* synthesis PAP_MARK_DEBUG=”true”*/;
wire            axis_slave0_tvalid      /* synthesis PAP_MARK_DEBUG=”true”*/;
wire    [127:0] axis_slave0_tdata       /* synthesis PAP_MARK_DEBUG=”true”*/;
wire            axis_slave0_tlast       /* synthesis PAP_MARK_DEBUG=”true”*/;
wire            axis_slave0_tuser       /* synthesis PAP_MARK_DEBUG=”true”*/;

//axis slave 1 interface
wire            axis_slave1_tready      /* synthesis PAP_MARK_DEBUG=”true”*/;
wire            axis_slave1_tvalid      /* synthesis PAP_MARK_DEBUG=”true”*/;
wire    [127:0] axis_slave1_tdata       /* synthesis PAP_MARK_DEBUG=”true”*/;
wire            axis_slave1_tlast       /* synthesis PAP_MARK_DEBUG=”true”*/;
wire            axis_slave1_tuser       /* synthesis PAP_MARK_DEBUG=”true”*/;

//axis slave 2 interface
wire            axis_slave2_tready      /* synthesis PAP_MARK_DEBUG=”true”*/;
wire            axis_slave2_tvalid      /* synthesis PAP_MARK_DEBUG=”true”*/;
wire    [127:0] axis_slave2_tdata       /* synthesis PAP_MARK_DEBUG=”true”*/;
wire            axis_slave2_tlast       /* synthesis PAP_MARK_DEBUG=”true”*/;
wire            axis_slave2_tuser       /* synthesis PAP_MARK_DEBUG=”true”*/;

wire    [7:0]   cfg_pbus_num            ;
wire    [4:0]   cfg_pbus_dev_num        ;
wire    [2:0]   cfg_max_rd_req_size     ;
wire    [2:0]   cfg_max_payload_size    ;
wire            cfg_rcb                 ;

//system signal
wire    [4:0]   smlh_ltssm_state        /* synthesis PAP_MARK_DEBUG=”true”*/;
wire            smlh_link_up            ;   // 20261018 disp: internal now

// 20261018 disp: ext regs / arbiter / display interconnect
wire [11:0]     ext_rd_addr         ;
wire [127:0]    ext_rd_data         ;
wire            ext_cfg_tgl         ;
wire [15:0]     ext_cfg_ctrl        ;
wire [31:0]     ext_fb_base         ;
wire [31:0]     ext_slot_size       ;
wire [31:0]     ext_stride          ;
wire [31:0]     ext_uv_off          ;
wire            ext_commit_tgl      ;
wire [1:0]      ext_commit_slot     ;
wire [15:0]     ext_commit_fid      ;
wire            ext_stat_tgl        ;
wire [159:0]    ext_stat_bus        ;
wire [4:0]      ext_key_stat        ;
wire [7:0]      ext_led_host        ;
wire [7:0]      ext_led_oe          ;

// 20261018 osd1: OSD register/event interconnect
wire            ext_osd_cfg_tgl     ;
wire [1065:0]   ext_osd_cfg         ;
wire            ext_tram_we         ;
wire [5:0]      ext_tram_addr       ;
wire [31:0]     ext_tram_data       ;
wire            ext_evt_tgl         ;
wire [2:0]      ext_evt_key         ;
wire [1:0]      ext_evt_type        ;
wire [5:0]      ext_evt_step        ;
wire            ext_drv_tgl         ;
wire [9:0]      ext_drv_bus         ;
wire            ext_cal_tgl         ;
wire [59:0]     ext_cal_bus         ;

//uart2apb 32bits
wire            uart_p_sel              ;
wire    [3:0]   uart_p_strb             ;
wire    [15:0]  uart_p_addr             ;
wire    [31:0]  uart_p_wdata            ;
wire            uart_p_ce               ;
wire            uart_p_we               ;
wire            uart_p_rdy              ;
wire    [31:0]  uart_p_rdata            ;

// 20261018 ddr: PCIe DMA <-> rt_ddr_hub interconnect
wire            bar1_tap_vld        ;   // 20261018 ddr:
wire [11:0]     bar1_tap_addr       ;   // 20261018 ddr:
wire [31:0]     bar1_tap_data       ;   // 20261018 ddr:
wire            mrd_start_hub       ;   // 20261018 ddr:
wire            mrd_done_hub        ;   // 20261018 ddr:
wire            db_ack_hub          ;   // 20261018 ddr:
wire            hub_db_req          ;   // 20261018 ddr:
wire [31:0]     hub_db_addr         ;   // 20261018 ddr:
wire [19:0]     hub_db_len_dw       ;   // 20261018 ddr:
wire            hub_issue_hold      ;   // 20261018 ddr:
wire            hub_start_block     ;   // 20261018 ddr:
wire            hub_final_done_host ;   // 20261018 ddr:
wire [127:0]    hub_stat1c0         ;   // 20261018 ddr:
wire [127:0]    hub_stat1d0         ;   // 20261018 ddr:
wire [127:0]    hub_stat1e0         ;   // 20261018 ddr:
wire            hub_copy_wr_en      ;   // 20261018 ddr:
wire [11:0]     hub_copy_wr_addr    ;   // 20261018 ddr:
wire [127:0]    hub_copy_wr_data    ;   // 20261018 ddr:

//----------------------------------------------------------rst debounce ----------------------------------------------------------

hsst_rst_cross_sync_v1_0 #(
    `ifdef IPS2L_PCIE_SPEEDUP_SIM
    .RST_CNTR_VALUE     (16'h10             )
    `else
    .RST_CNTR_VALUE     (16'hC000           )
    `endif
)
u_refclk_buttonrstn_debounce(
    .clk                (ref_clk            ),
    .rstn_in            (1'b1               ),
    .rstn_out           (sync_button_rst_n  )
);

hsst_rst_cross_sync_v1_0 #(
    `ifdef IPS2L_PCIE_SPEEDUP_SIM
    .RST_CNTR_VALUE     (16'h10             )
    `else
    .RST_CNTR_VALUE     (16'hC000           )
    `endif
)
u_refclk_perstn_debounce(
    .clk                (ref_clk            ),
    .rstn_in            (perst_n            ),
    .rstn_out           (sync_perst_n       )
);

hsst_rst_sync_v1_0  u_ref_core_rstn_sync    (
    .clk                (ref_clk            ),
    .rst_n              (core_rst_n         ),
    .sig_async          (1'b1               ),
    .sig_synced         (ref_core_rst_n     )
);

hsst_rst_sync_v1_0  u_pclk_core_rstn_sync   (
    .clk                (pclk               ),
    .rst_n              (core_rst_n         ),
    .sig_async          (1'b1               ),
    .sig_synced         (s_pclk_rstn        )
);


//---------------------------------------------------------- dbg sticky led (20261017 dbg) ----------------------------------------------------------
wire            dbg_pll_lock        /* synthesis PAP_MARK_DEBUG="true" */;
wire            dbg_tx_rst_done     /* synthesis PAP_MARK_DEBUG="true" */;
wire    [1:0]   dbg_cdr_align       /* synthesis PAP_MARK_DEBUG="true" */;
wire    [1:0]   dbg_lsm_synced      /* synthesis PAP_MARK_DEBUG="true" */;
wire            rdlh_link_up_int    /* synthesis PAP_MARK_DEBUG="true" */;

// 2-stage synchronizers into ref_clk domain (async reset by sync_perst_n)
reg     [1:0]   sync_pll_lock;
reg     [1:0]   sync_tx_rst_done;
reg     [1:0]   sync_cdr_align0;
reg     [1:0]   sync_cdr_align1;
reg     [1:0]   sync_pollcfg;
reg     [1:0]   sync_cfg;

// LTSSM flags sampled in pclk_div2 domain (no reset)
reg             ltssm_is_pollcfg;
reg             ltssm_is_cfg;
always @(posedge pclk_div2)
begin
    ltssm_is_pollcfg <= (smlh_ltssm_state == 5'h04);
    ltssm_is_cfg     <= (smlh_ltssm_state >= 5'h07) && (smlh_ltssm_state <= 5'h0C);
end

// sticky flags in ref_clk domain
reg             st_pll;
reg             st_txdone;
reg             st_cdr0;
reg             st_cdr1;
reg             st_pollcfg;
reg             st_cfg;

always @(posedge ref_clk or negedge sync_perst_n)
begin
    if (!sync_perst_n)
    begin
        sync_pll_lock    <= 2'd0;
        sync_tx_rst_done <= 2'd0;
        sync_cdr_align0  <= 2'd0;
        sync_cdr_align1  <= 2'd0;
        sync_pollcfg     <= 2'd0;
        sync_cfg         <= 2'd0;
        st_pll           <= 1'b0;
        st_txdone        <= 1'b0;
        st_cdr0          <= 1'b0;
        st_cdr1          <= 1'b0;
        st_pollcfg       <= 1'b0;
        st_cfg           <= 1'b0;
    end
    else
    begin
        sync_pll_lock    <= {sync_pll_lock[0],    dbg_pll_lock};
        sync_tx_rst_done <= {sync_tx_rst_done[0], dbg_tx_rst_done};
        sync_cdr_align0  <= {sync_cdr_align0[0],  dbg_cdr_align[0]};
        sync_cdr_align1  <= {sync_cdr_align1[0],  dbg_cdr_align[1]};
        sync_pollcfg     <= {sync_pollcfg[0],     ltssm_is_pollcfg};
        sync_cfg         <= {sync_cfg[0],         ltssm_is_cfg};

        if (sync_pll_lock[1])    st_pll     <= 1'b1;
        if (sync_tx_rst_done[1]) st_txdone  <= 1'b1;
        if (sync_cdr_align0[1])  st_cdr0    <= 1'b1;
        if (sync_cdr_align1[1])  st_cdr1    <= 1'b1;
        if (sync_pollcfg[1])     st_pollcfg <= 1'b1;
        if (sync_cfg[1])         st_cfg     <= 1'b1;
    end
end

// 20261017 dbg: sticky flags kept internal only (no longer on pins)

//----------------------------------------------------------   dma  ----------------------------------------------------------

wire                        cpld_finish        ; 
wire                        mwr_req_cmd        ;
wire                        mwr_tx_start       ;	
wire    [31:0]              rd_base_ram_addr   ;	
wire    [31:0]              wr_base_ram_addr   ;
wire    [10:0]              mem_length         ;

wire                        pio_wr_en          ;
wire    [15:0]              pio_wr_byte_en     ; 
wire    [ADDR_WIDTH-1:0]    pio_wr_addr        ;
wire    [127:0]             pio_wr_data        ;
wire                        pio_rd_en          ;
wire    [ADDR_WIDTH-1:0]    pio_rd_addr        ;
wire    [127:0]             pio_rd_data        ;

wire                        dma_wr_en          ;
wire    [15:0]              dma_wr_byte_en     ; 
wire    [ADDR_WIDTH-1:0]    dma_wr_addr        ;
wire    [127:0]             dma_wr_data        ;
wire                        dma_rd_en          ;
wire    [ADDR_WIDTH-1:0]    dma_rd_addr        ;
wire    [127:0]             dma_rd_data        ;
	
rt_pcie_dma #(
    .ADDR_WIDTH             (ADDR_WIDTH             ),
	.RD_DATA_DELAY          (RD_DATA_DELAY          )   //receive rd_data delay clk cyle, support 1、2、3 clk cyle.
)
u_rt_pcie_dma
(
    .clk                    (pclk_div2              ),  //gen1:62.5MHz,gen2:125MHz
    .rst_n                  (core_rst_n             ),
    //num
    .i_cfg_pbus_num         (cfg_pbus_num           ),  //input [7:0]
    .i_cfg_pbus_dev_num     (cfg_pbus_dev_num       ),  //input [4:0]
    .i_cfg_max_rd_req_size  (cfg_max_rd_req_size    ),  //input [2:0]
    .i_cfg_max_payload_size (cfg_max_payload_size   ),  //input [2:0]
    //**********************************************************************
    //axis master interface
    .i_axis_master_tvld     (axis_master_tvalid     ),  //input  [0:0]
    .o_axis_master_trdy     (axis_master_tready     ),  //output [0:0]
    .i_axis_master_tdata    (axis_master_tdata      ),  //input  [127:0]
    .i_axis_master_tkeep    (axis_master_tkeep      ),  //input  [3:0]
    .i_axis_master_tlast    (axis_master_tlast      ),  //input  [0:0]
    .i_axis_master_tuser    (axis_master_tuser      ),  //input  [7:0]

    //**********************************************************************
    //axis_slave0 interface
    .i_axis_slave0_trdy     (axis_slave0_tready     ),  //input  [0:0]
    .o_axis_slave0_tvld     (axis_slave0_tvalid     ),  //output [0:0]
    .o_axis_slave0_tdata    (axis_slave0_tdata      ),  //output [127:0]
    .o_axis_slave0_tlast    (axis_slave0_tlast      ),  //output [0:0]
    .o_axis_slave0_tuser    (axis_slave0_tuser      ),  //output [0:0]
    //axis_slave1 interface
    .i_axis_slave1_trdy     (axis_slave1_tready     ),  //input  [0:0]
    .o_axis_slave1_tvld     (axis_slave1_tvalid     ),  //output [0:0]
    .o_axis_slave1_tdata    (axis_slave1_tdata      ),  //output [127:0]
    .o_axis_slave1_tlast    (axis_slave1_tlast      ),  //output [0:0]
    .o_axis_slave1_tuser    (axis_slave1_tuser      ),  //output [0:0]
    //axis_slave2 interface
    .i_axis_slave2_trdy     (axis_slave2_tready     ),  //input  [0:0]
    .o_axis_slave2_tvld     (axis_slave2_tvalid     ),  //output [0:0]
    .o_axis_slave2_tdata    (axis_slave2_tdata      ),  //output [127:0]
    .o_axis_slave2_tlast    (axis_slave2_tlast      ),  //output [0:0]
    .o_axis_slave2_tuser    (axis_slave2_tuser      ),  //output [0:0]
    //**********************************************************************
	
	.i_cpld_finish           (cpld_finish           ),  //input  [0:0]  //表明接收cpld完成             
    .o_mwr_req_cmd           (mwr_req_cmd           ),  //output [0:0]  //mwr读指令来后，需要去开始读16in_16out_ram  1clk        
    .i_mwr_tx_start          (mwr_tx_start          ),  //input  [0:0]  //这个信号表示数据已经搬到16in_128out ram.可以开始mwr组包  1clk	
    .o_rd_base_ram_addr      (rd_base_ram_addr      ),  //output [31:0]
    .o_wr_base_ram_addr      (wr_base_ram_addr      ),  //output [31:0]
    .o_mem_length            (mem_length            ),  //output [10:0]	
    //**********************************************************************	
    //////ram interface
	//pio write to ram
	.o_pio_wr_en             (pio_wr_en             ),  //output [0:0]
    .o_pio_wr_byte_en        (pio_wr_byte_en        ),  //output [15:0]
    .o_pio_wr_addr           (pio_wr_addr           ),  //output [63:0]
    .o_pio_wr_data           (pio_wr_data           ),  //output [127:0]
	//pio read from ram                        
	.o_pio_rd_en             (pio_rd_en             ),  //output [0:0]
    .o_pio_rd_addr           (pio_rd_addr           ),  //output [63:0]
    .i_pio_rd_data           (pio_rd_data           ),	//input  [127:0]
	
    //dma cpld, write to ram
	.o_dma_wr_en             (dma_wr_en             ),  //output [0:0]
    .o_dma_wr_byte_en        (dma_wr_byte_en        ),  //output [15:0]
    .o_dma_wr_addr           (dma_wr_addr           ),  //output [ADDR_WIDTH-1:0]
    .o_dma_wr_data           (dma_wr_data           ),  //output [127:0]
	//dma mwr, read from ram
	.o_dma_rd_en             (dma_rd_en             ),  //output [0:0]
    .o_dma_rd_addr           (dma_rd_addr           ),  //output [ADDR_WIDTH-1:0]
    .i_dma_rd_data           (dma_rd_data           ),  //input  [127:0]
    // 20261018 ddr: DDR doorbell / BAR1 tap interface
    .o_bar1_tap_vld          (bar1_tap_vld          ),   // 20261018 ddr:
    .o_bar1_tap_addr         (bar1_tap_addr         ),   // 20261018 ddr:
    .o_bar1_tap_data         (bar1_tap_data         ),   // 20261018 ddr:
    .o_mrd_start             (mrd_start_hub         ),   // 20261018 ddr:
    .o_mrd_done              (mrd_done_hub          ),   // 20261018 ddr:
    .o_db_ack                (db_ack_hub            ),   // 20261018 ddr:
    .i_db_req                (hub_db_req            ),   // 20261018 ddr:
    .i_db_addr               (hub_db_addr           ),   // 20261018 ddr:
    .i_db_len_dw             (hub_db_len_dw         ),   // 20261018 ddr:
    .i_issue_hold            (hub_issue_hold        ),   // 20261018 ddr:
    .i_start_block           (hub_start_block       ),   // 20261018 ddr:
    .i_final_done_host       (hub_final_done_host   ),   // 20261018 ddr:
    .i_stat1c0               (hub_stat1c0           ),   // 20261018 ddr:
    .i_stat1d0               (hub_stat1d0           ),   // 20261018 ddr:
    .i_stat1e0               (hub_stat1e0           ),   // 20261018 ddr:
    .i_ext_rd_data           (ext_rd_data           ),   // 20261018 disp:
    .o_ext_rd_addr           (ext_rd_addr           )    // 20261018 disp:
);

//**********************************************************************
/////////////////////////////////////////////////////////////////PIO RAM
ram_128in_128out u_ram_128in_128out
(
    .wr_clk             (pclk_div2               ),  // input
    .wr_rst             (~core_rst_n             ),  // input
    .wr_en              (pio_wr_en               ),  // input
    .wr_byte_en         (pio_wr_byte_en          ),  // input [15:0]
    .wr_addr            (pio_wr_addr[11:0]       ),  // input [11:0]
    .wr_data            (pio_wr_data             ),  // input [127:0]
    .rd_clk             (pclk_div2               ),  // input
    .rd_rst             (~core_rst_n             ),  // input
    .rd_clk_en          (pio_rd_en               ),  // input
    .rd_addr            (pio_rd_addr[11:0]       ),  // input [11:0]
    .rd_data            (pio_rd_data             )   // output[127:0]
);


/////////////////////////////////////////////////////////////////DMA
wire            dma_ram_wr_en      ;
wire    [31:0]  dma_ram_wr_addr    ;
wire    [15:0]  dma_ram_wr_data    ;
wire    [1:0]   dma_ram_wr_byte_en ; 

wire            dma_ram_rd_en      ;
wire    [31:0]  dma_ram_rd_addr    ;
wire    [15:0]  dma_ram_rd_data    ;

rt_gs_dma_interface_conversion #(
    .ADDR_WIDTH              (ADDR_WIDTH          ),
	.RD_DATA_DELAY           (RD_DATA_DELAY       ),   //receive rd_data delay clk cyle, support 1、2、3 clk cyle.
	.FAST_PATH               (1)                       // 20261018 fast: 128-bit DMA RAM, no 16-bit repack
)
u_rt_gs_dma_interface_conversion
(
    .clk                     (pclk_div2           ),  // input
    .rst_n                   (core_rst_n          ),  // input
	//128bit write           
    .i_dma_wr_en             (dma_wr_en           ),  // input
    .i_dma_wr_byte_en        (dma_wr_byte_en      ),  // input [15:0]
    .i_dma_wr_addr           (dma_wr_addr         ),  // input [ADDR_WIDTH-1:0]
    .i_dma_wr_data           (dma_wr_data         ),  // input [127:0]
	//16bit write            
    .o_dma_ram_wr_en         (dma_ram_wr_en       ),  // output
    .o_dma_ram_wr_byte_en    (dma_ram_wr_byte_en  ),  // output [1:0]
    .o_dma_ram_wr_addr       (dma_ram_wr_addr     ),  // output [ADDR_WIDTH-1:0]
    .o_dma_ram_wr_data       (dma_ram_wr_data     ),  // output [15:0]
    //128bit read	         
    .i_dma_rd_en             (dma_rd_en           ),  // input 
    .i_dma_rd_addr           (dma_rd_addr         ),  // input  [ADDR_WIDTH-1:0]
	.o_dma_rd_data           (dma_rd_data         ),  // output [127:0]
    //16bit read		     
    .o_dma_ram_rd_en         (dma_ram_rd_en       ),  // output 
    .o_dma_ram_rd_addr       (dma_ram_rd_addr     ),  // output [ADDR_WIDTH-1:0]
    .i_dma_ram_rd_data       (dma_ram_rd_data     ),  // input  [15:0]
	/////////////////////////////////////////////////	
	//other ctrl
	.o_cpld_finish           (cpld_finish          ),  
    .i_mwr_req_cmd           (mwr_req_cmd          ),  
    .o_mwr_tx_start          (mwr_tx_start         ),  
    .i_rd_base_ram_addr      (rd_base_ram_addr     ),  
    .i_wr_base_ram_addr      (wr_base_ram_addr     ),  
	.i_mem_length            (mem_length           )   ,
    // 20261018 ddr: DDR readback copy write port
    .i_copy_wr_en            (hub_copy_wr_en       ),   // 20261018 ddr:
    .i_copy_wr_addr          (hub_copy_wr_addr     ),   // 20261018 ddr:
    .i_copy_wr_data          (hub_copy_wr_data     )    // 20261018 ddr:
);

//DMA RAM
ram_16in_16out u_ram_16in_16out 
(
    .wr_clk             (pclk_div2            ),  // input
    .wr_rst             (~core_rst_n          ),  // input
    .wr_en              (dma_ram_wr_en        ),  // input
    .wr_byte_en         (dma_ram_wr_byte_en   ),  // input [1:0]
    .wr_addr            (dma_ram_wr_addr[11:0]),  // input [11:0]
    .wr_data            (dma_ram_wr_data      ),  // input [15:0]
    .rd_clk             (pclk_div2            ),  // input
    .rd_rst             (~core_rst_n          ),  // input
    .rd_clk_en          (dma_ram_rd_en        ),  // input
    .rd_addr            (dma_ram_rd_addr[11:0]),  // input  [11:0]
    .rd_data            (dma_ram_rd_data      )   // output [15:0]
);

//----------------------------------------------------------   ddr3 (20261018 ddr) ----------------------------------------------------------
// 20261018 ddr: DDR3 125MHz differential reference clock
wire            ddr_ref_clk         ;   // 20261018 ddr:
GTP_INBUFGDS #(
    .IOSTANDARD     ("DEFAULT"),
    .TERM_DIFF      ("ON")
) u_ddr_refclk (
    .O              (ddr_ref_clk            ),   // 20261018 ddr:
    .I              (clk_p                  ),   // 20261018 ddr:
    .IB             (clk_n                  )    // 20261018 ddr:
);

// 20261018 ddr: power-on reset (20-bit counter on free_clk, registers init 0)
reg     [19:0]  por_cnt             = 20'd0;   // 20261018 ddr:
reg             por_done            = 1'b0;    // 20261018 ddr:
always @(posedge free_clk)   // 20261018 ddr:
begin
    if (!por_done)
    begin
        por_cnt <= por_cnt + 20'd1;   // 20261018 ddr:
        if (por_cnt == 20'hFFFFF)
            por_done <= 1'b1;   // 20261018 ddr:
    end
end

wire            ddr_resetn          ;   // 20261018 ddr:
assign ddr_resetn = por_done;   // 20261018 ddr: (POR only)

// 20261018 ddr: DDR core domain outputs
wire            ddr_core_clk        ;   // 20261018 ddr:
wire            ddr_init_done       ;   // 20261018 ddr:
wire            ddr_rst_n           ;   // 20261018 ddr:
wire            ddr_pll_lock        ;   // 20261018 ddr:
wire            ddr_phy_pll_lock    ;   // 20261018 ddr:
wire            ddr_gpll_lock       ;   // 20261018 ddr:
wire            ddr_rst_gpll_lock   ;   // 20261018 ddr:
wire            ddr_ddrphy_cpd_lock ;   // 20261018 ddr:

// 20261018 ddr: async assert / sync release reset for DDR hub
reg     [1:0]   ddr_rstn_sync       ;   // 20261018 ddr:
always @(posedge ddr_core_clk or negedge ddr_resetn)   // 20261018 ddr:
begin
    if (!ddr_resetn)
        ddr_rstn_sync <= 2'b00;   // 20261018 ddr:
    else
        ddr_rstn_sync <= {ddr_rstn_sync[0], 1'b1};   // 20261018 ddr:
end
assign ddr_rst_n = ddr_rstn_sync[1];   // 20261018 ddr:

// 20261018 ddr: AXI between DDR3 IP and rt_ddr_hub
wire [27:0]     ddr_axi_awaddr      ;   // 20261018 ddr:
wire [3:0]      ddr_axi_awlen       ;   // 20261018 ddr:
wire            ddr_axi_awvalid     ;   // 20261018 ddr:
wire            ddr_axi_awready     ;   // 20261018 ddr:
wire [255:0]    ddr_axi_wdata       ;   // 20261018 ddr:
wire [31:0]     ddr_axi_wstrb       ;   // 20261018 ddr:
wire            ddr_axi_wready      ;   // 20261018 ddr:
wire [27:0]     ddr_axi_araddr      ;   // 20261018 ddr:
wire [3:0]      ddr_axi_arlen       ;   // 20261018 ddr:
wire            ddr_axi_arvalid     ;   // 20261018 ddr:
wire            ddr_axi_arready     ;   // 20261018 ddr:
wire [255:0]    ddr_axi_rdata       ;   // 20261018 ddr:
wire            ddr_axi_rlast       ;   // 20261018 ddr:
wire            ddr_axi_rvalid      ;   // 20261018 ddr:
wire [3:0]      ddr_axi_aruser_id   ;   // 20261018 disp:

// 20261018 disp: arbiter client buses
wire [27:0]     hub_axi_araddr      ;
wire [3:0]      hub_axi_arlen       ;
wire            hub_axi_arvalid     ;
wire            hub_axi_arready     ;
wire [255:0]    hub_axi_rdata       ;
wire            hub_axi_rlast       ;
wire            hub_axi_rvalid      ;
wire [27:0]     dsp_axi_araddr      ;
wire [3:0]      dsp_axi_arlen       ;
wire            dsp_axi_arvalid     ;
wire            dsp_axi_arready     ;
wire [255:0]    dsp_axi_rdata       ;
wire            dsp_axi_rlast       ;
wire            dsp_axi_rvalid      ;


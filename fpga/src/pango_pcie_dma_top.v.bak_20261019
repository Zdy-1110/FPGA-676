    .radm_idle                  (                       ),      //output
    .radm_q_not_empty           (                       ),      //output
    .radm_qoverflow             (                       ),      //output
    .diag_ctrl_bus              (2'b0                   ),      //input   [1:0]
    .cfg_link_auto_bw_mux       (                       ),      //output              merge cfg_link_auto_bw_msi and cfg_link_auto_bw_int
    .cfg_bw_mgt_mux             (                       ),      //output              merge cfg_bw_mgt_int and cfg_bw_mgt_msi
    .cfg_pme_mux                (                       ),      //output              merge cfg_pme_int and cfg_pme_msi
    .app_ras_des_sd_hold_ltssm  (1'b0                   ),      //input
    .app_ras_des_tba_ctrl       (2'b0                   ),      //input   [1:0]
    
    .dyn_debug_info_sel         (4'b0                   ),      //input   [3:0]
    .debug_info_mux             (                       ),      //output  [132:0]
    
    //system signal
    .smlh_link_up               (smlh_link_up           ),      //output
    .rdlh_link_up               (rdlh_link_up_int       ),      //output  // 20261017 dbg: internal wire
    .smlh_ltssm_state           (smlh_ltssm_state       ),      //output  [4:0]
    // 20261017 dbg: PHY status inputs
    .o_dbg_pll_lock             (dbg_pll_lock           ),      //output
    .o_dbg_cdr_align            (dbg_cdr_align          ),      //output  [1:0]
    .o_dbg_lsm_synced           (dbg_lsm_synced         ),      //output  [1:0]
    .o_dbg_tx_rst_done          (dbg_tx_rst_done        )       //output
);

//---------------------------------------------------------- ltssm logger (20261017 log) ----------------------------------------------------------
// 20261017 log: status flags {perst_n,pll_lock,tx_rst_done,cdr1,cdr0,lsm1,lsm0,link_up}
wire    [7:0]   ltssm_dbg_flags;

assign ltssm_dbg_flags = {perst_n, dbg_pll_lock, dbg_tx_rst_done,
                          dbg_cdr_align[1], dbg_cdr_align[0],
                          dbg_lsm_synced[1], dbg_lsm_synced[0], smlh_link_up};

ltssm_logger u_ltssm_logger
(
    .free_clk    (free_clk        ),   // 20261017 log: 27MHz domain
    .pclk_div2   (pclk_div2       ),   // 20261017 log: PCIe core domain
    .ltssm_state (smlh_ltssm_state),   // 20261017 log: [4:0]
    .flags_async (ltssm_dbg_flags ),   // 20261017 log: [7:0]
    .txd         (txd             )    // 20261017 log: UART TX
);

endmodule

// 20261017 log: ============================================================
// 20261017 log: ltssm_logger
// 20261017 log:   Records LTSSM state / status-flag transitions with a 1us
// 20261017 log:   timestamp, buffers them in a 512x48 sync FIFO and streams
// 20261017 log:   ASCII lines out of an 8N1 UART on the 27MHz free_clk.
// 20261017 log: ============================================================
module ltssm_logger
(
    input           free_clk    ,   // 20261017 log: 27 MHz board oscillator
    input           pclk_div2   ,   // 20261017 log: PCIe core clock domain
    input   [4:0]   ltssm_state ,   // 20261017 log: smlh_ltssm_state
    input   [7:0]   flags_async ,   // 20261017 log: {perst,pll,txdone,cdr1,cdr0,lsm1,lsm0,link}
    output  reg     txd             // 20261017 log: UART TX
);

    localparam       BAUD_DIV   = 29;       // 20261017 log: 27MHz/29 ~= 931kbaud
    localparam [5:0] INIT_STATE = 6'h3F;    // 20261017 log: last_state power-on value

    localparam [2:0] S_BANNER   = 3'd0;     // 20261017 log: FSM states
    localparam [2:0] S_CHK      = 3'd1;
    localparam [2:0] S_RDLAT    = 3'd2;
    localparam [2:0] S_TXCH     = 3'd3;
    localparam [2:0] S_TXWAIT   = 3'd4;

    reg      [2:0]  state   = S_BANNER;     // 20261017 log: FSM state (declaration init)

    // 20261017 log: -------- 1us tick + timestamp (free_clk) -----------------
    reg      [4:0]  div_cnt = 5'd0;
    reg      [31:0] ts_us   = 32'd0;

    always @(posedge free_clk)
    begin
        if (div_cnt == 5'd26)
            div_cnt <= 5'd0;
        else
            div_cnt <= div_cnt + 5'd1;
    end

    wire tick_us = (div_cnt == 5'd26);

    always @(posedge free_clk)
    begin
        if (tick_us)
            ts_us <= ts_us + 32'd1;
    end

    // 20261017 log: -------- LTSSM cross domain (1FF + 3FF sync) -------------
    reg      [4:0]  ltssm_q  = 5'd0;
    always @(posedge pclk_div2)
        ltssm_q <= ltssm_state;

    reg      [4:0]  ltssm_s1 = 5'd0;
    reg      [4:0]  ltssm_s2 = 5'd0;
    reg      [4:0]  ltssm_s3 = 5'd0;
    always @(posedge free_clk)
    begin
        ltssm_s1 <= ltssm_q;
        ltssm_s2 <= ltssm_s1;
        ltssm_s3 <= ltssm_s2;
    end

    wire            ltssm_stable_vld = (ltssm_s3 == ltssm_s2);   // 20261017 log: stable when s3==s2
    wire     [4:0]  ltssm_stable     = ltssm_s3;

    // 20261017 log: -------- flags cross domain (2FF sync) -------------------
    reg      [7:0]  flags_s1 = 8'd0;
    reg      [7:0]  flags_s  = 8'd0;
    always @(posedge free_clk)
    begin
        flags_s1 <= flags_async;
        flags_s  <= flags_s1;
    end

    // 20261017 log: -------- event detection ---------------------------------
    reg      [5:0]  last_state      = INIT_STATE;
    reg      [7:0]  last_flags      = 8'h00;
    reg             dropped_pending = 1'b0;

    wire state_changed = ltssm_stable_vld &&
                         ((ltssm_stable != last_state[4:0]) || (last_state == INIT_STATE));
    wire flags_changed = (flags_s != last_flags);
    wire ev_valid      = state_changed || flags_changed;

    // 20261017 log: -------- sync FIFO 512 x 48 (block RAM) ------------------
    reg      [47:0] mem [0:511];
    reg      [8:0]  wr_ptr    = 9'd0;
    reg      [8:0]  rd_ptr    = 9'd0;
    reg      [9:0]  fifo_cnt  = 10'd0;
    reg      [47:0] rd_data   = 48'd0;

    wire            fifo_full  = (fifo_cnt == 10'd512);
    wire            fifo_empty = (fifo_cnt == 10'd0);
    wire            pop        = (state == S_CHK) && !fifo_empty;
    wire            ev_write   = ev_valid && !fifo_full;
    // 20261017 log: record = {ts_us[31:0], flags_s[7:0], dropped, 2'b00, state[4:0]}
    wire     [47:0] ev_data    = {ts_us, flags_s, dropped_pending, 2'b00, ltssm_stable};

    always @(posedge free_clk)
    begin
        if (ev_write)
        begin
            mem[wr_ptr] <= ev_data;
            wr_ptr      <= wr_ptr + 9'd1;
        end
    end

    always @(posedge free_clk)
        rd_data <= mem[rd_ptr];     // 20261017 log: registered read -> block RAM

    always @(posedge free_clk)
    begin
        if (ev_valid && fifo_full)
            dropped_pending <= 1'b1;
        else if (ev_write)
            dropped_pending <= 1'b0;
    end

    always @(posedge free_clk)
    begin
        if (ev_write)
        begin
            last_state <= {1'b0, ltssm_stable};
            last_flags <= flags_s;
        end
    end

    always @(posedge free_clk)
    begin
        if (pop)
            rd_ptr <= rd_ptr + 9'd1;
    end

    always @(posedge free_clk)
    begin
        case ({ev_write, pop})
            2'b10:   fifo_cnt <= fifo_cnt + 10'd1;
            2'b01:   fifo_cnt <= fifo_cnt - 10'd1;
            default: ;
        endcase
    end

    // 20261017 log: -------- UART TX 8N1 -------------------------------------
    reg      [9:0]  tx_shifter = 10'h3FF;
    reg      [4:0]  baud_cnt   = 5'd0;
    reg      [3:0]  bit_cnt    = 4'd0;
    reg             tx_busy    = 1'b0;
    reg             tx_start   = 1'b0;
    reg      [7:0]  tx_byte    = 8'h00;

    always @(posedge free_clk)
    begin
        if (!tx_busy)
        begin
            txd <= 1'b1;                                // 20261017 log: idle high
            if (tx_start)
            begin
                tx_busy    <= 1'b1;
                tx_shifter <= {1'b1, tx_byte, 1'b0};    // 20261017 log: {stop,data,start}
                baud_cnt   <= 5'd0;
                bit_cnt    <= 4'd0;
                txd        <= 1'b0;                     // 20261017 log: start bit
            end
        end
        else
        begin
            if (baud_cnt == BAUD_DIV-1)
            begin
                baud_cnt <= 5'd0;
                if (bit_cnt == 4'd9)
                begin
                    tx_busy <= 1'b0;
                    txd     <= 1'b1;                    // 20261017 log: stop bit
                end
                else
                begin
                    tx_shifter <= {1'b1, tx_shifter[9:1]};
                    txd        <= tx_shifter[1];
                    bit_cnt    <= bit_cnt + 4'd1;
                end
            end
            else
            begin
                baud_cnt <= baud_cnt + 5'd1;
            end
        end
    end

    // 20261017 log: -------- record character buffer -------------------------
    reg      [7:0]  rec_buf [0:15];

    function [7:0] hex2ascii;
        input [3:0] n;
        begin
            hex2ascii = (n < 4'd10) ? (8'h30 + {4'b0, n}) : (8'h37 + {4'b0, n});
        end
    endfunction

    function [7:0] banner_char_fn;
        input [4:0] idx;
        begin
            case (idx)
                5'd0 :   banner_char_fn = "\r";
                5'd1 :   banner_char_fn = "\n";
                5'd2 :   banner_char_fn = "L";
                5'd3 :   banner_char_fn = "T";
                5'd4 :   banner_char_fn = "S";
                5'd5 :   banner_char_fn = "S";
                5'd6 :   banner_char_fn = "M";
                5'd7 :   banner_char_fn = "L";
                5'd8 :   banner_char_fn = "O";
                5'd9 :   banner_char_fn = "G";
                5'd10:   banner_char_fn = " ";
                5'd11:   banner_char_fn = "2";
                5'd12:   banner_char_fn = "0";
                5'd13:   banner_char_fn = "2";
                5'd14:   banner_char_fn = "6";
                5'd15:   banner_char_fn = "1";
                5'd16:   banner_char_fn = "0";
                5'd17:   banner_char_fn = "1";
                5'd18:   banner_char_fn = "7";
                5'd19:   banner_char_fn = "\r";
                5'd20:   banner_char_fn = "\n";
                default: banner_char_fn = 8'h00;
            endcase
        end
    endfunction

    reg      [4:0]  msg_idx   = 5'd0;
    reg      [4:0]  msg_len   = 5'd21;
    reg             in_banner = 1'b1;
    reg             seen_busy = 1'b0;

    wire     [7:0]  cur_char = in_banner ? banner_char_fn(msg_idx) : rec_buf[msg_idx];

    // 20261017 log: -------- transmit FSM ------------------------------------
    always @(posedge free_clk)
    begin
        case (state)
            S_BANNER:
            begin
                in_banner <= 1'b1;
                msg_len   <= 5'd21;
                msg_idx   <= 5'd0;
                seen_busy <= 1'b0;
                state     <= S_TXCH;
            end

            S_CHK:
            begin
                if (!fifo_empty)
                    state <= S_RDLAT;
            end

            S_RDLAT:
            begin
                in_banner <= 1'b0;
                msg_len   <= 5'd16;
                msg_idx   <= 5'd0;
                seen_busy <= 1'b0;
                rec_buf[0]  <= hex2ascii(rd_data[47:44]);
                rec_buf[1]  <= hex2ascii(rd_data[43:40]);
                rec_buf[2]  <= hex2ascii(rd_data[39:36]);
                rec_buf[3]  <= hex2ascii(rd_data[35:32]);
                rec_buf[4]  <= hex2ascii(rd_data[31:28]);
                rec_buf[5]  <= hex2ascii(rd_data[27:24]);
                rec_buf[6]  <= hex2ascii(rd_data[23:20]);
                rec_buf[7]  <= hex2ascii(rd_data[19:16]);
                rec_buf[8]  <= 8'h20;
                rec_buf[9]  <= hex2ascii(rd_data[15:12]);
                rec_buf[10] <= hex2ascii(rd_data[11:8]);
                rec_buf[11] <= rd_data[7] ? 8'h21 : 8'h20;
                rec_buf[12] <= hex2ascii({3'b000, rd_data[4]});
                rec_buf[13] <= hex2ascii(rd_data[3:0]);
                rec_buf[14] <= 8'h0D;
                rec_buf[15] <= 8'h0A;
                state      <= S_TXCH;
            end

            S_TXCH:
            begin
                tx_byte   <= cur_char;
                tx_start  <= 1'b1;
                seen_busy <= 1'b0;
                state     <= S_TXWAIT;
            end

            S_TXWAIT:
            begin
                tx_start <= 1'b0;
                if (!seen_busy)
                begin
                    if (tx_busy)
                        seen_busy <= 1'b1;
                end
                else
                begin
                    if (!tx_busy)
                    begin
                        if (msg_idx == msg_len - 5'd1)
                            state <= S_CHK;
                        else
                        begin
                            msg_idx <= msg_idx + 5'd1;
                            state   <= S_TXCH;
                        end
                    end
                end
            end

            default:
                state <= S_BANNER;
        endcase
    end

endmodule
